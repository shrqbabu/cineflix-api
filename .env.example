# ==============================================================
# 🎬 MovieBox Node.js Server Environment Configuration (.env)
# ==============================================================

# Server Port (Default: 8080)
PORT=8080

# ==============================================================
# ⚡ Cloudflare Workers Multi-Pool & Smart Failover (Zero-Downtime)
# ==============================================================
# Add comma-separated Cloudflare Workers. The system automatically
# load balances and shifts to backup workers if one worker goes down/429.
CLOUDFLARE_WORKERS=https://live.betadda.workers.dev,https://live.clineflix.workers.dev,https://live-cdn.clineflix-e0d.workers.dev,https://live-cdn.clineflix-73f.workers.dev

# Primary Base Host fallback URL
BASE_HOST_URL=https://live.betadda.workers.dev
EXOPLAYER_URL=https://cineflix-ott.duckdns.org/player

# Environment Mode (production / development)
NODE_ENV=production

# App Secret Key for Native Android App Authorization
# (Must match BuildConfig.APP_SECRET_KEY in ott-app)
APP_SECRET=cineflix_sec_99a8b7c6d5e4f3a210

# Master Admin PIN to unlock Web UI Dashboard in browser
ADMIN_PIN=cineflix2026

# ==============================================================
# 🤖 MovieBox Interactive Telegram Bot (VPS Search, MX Player, VLC)
# ==============================================================
# Telegram Bot Token from @BotFather for the MovieBox search & player bot
# (Leave blank if you do not want to run the Telegram search bot)
MOVIEBOX_BOT_TOKEN=

# Dedicated VIP Subscription & Payment Bot username (without @)
VIP_BOT_USERNAME=CineFlixVIPBot

# Supabase Authentication & Database (matches Android App)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Bot Security / VPS Access Control:
# 1. Login Password: users must send `/login <password>` or `/login <user> <password>`
# (Defaults to ADMIN_PIN if left blank)
BOT_PASSWORD=cineflix2026

# 2. Optional Username required with password
BOT_USERNAME=admin

# 3. Multiple User credentials (comma-separated user:pass)
# BOT_AUTH_USERS=admin:cineflix2026,user1:pass123

# 4. Whitelisted Telegram User IDs (comma-separated, auto-authorized without login)
# (Send /id to the bot to check your numeric Telegram ID)
BOT_ALLOWED_USER_IDS=

# ==============================================================
# 🚀 Telegram MTProto Cloud Streaming Engine (telegram_stream.js)
# ==============================================================
# NOTE: If you are using BOTH telegram_stream.js AND the MovieBox bot,
# use DIFFERENT bot tokens to prevent Telegram "409 Conflict" errors.
# TG_API_ID & TG_API_HASH from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Telegram Bot Token used specifically by the MTProto client (telegram_stream.js)
TG_BOT_TOKEN=

# Default Private Storage Channel ID (e.g. -1001234567890)
TG_CHANNEL_ID=

